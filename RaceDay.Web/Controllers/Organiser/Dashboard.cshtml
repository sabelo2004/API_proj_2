@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center">
        <h2>Organiser Dashboard</h2>
        <!-- We will wire this button to the Create Event page next -->
        <button class="btn btn-success">Create New Event</button>
    </div>
    <hr />

    <div class="row">
        <div class="col-md-4">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <h5 class="card-title">Total Events</h5>
                    <h2 class="display-4">0</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white mb-4">
                <div class="card-body">
                    <h5 class="card-title">Total Enrolments</h5>
                    <h2 class="display-4">0</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-info text-white mb-4">
                <div class="card-body">
                    <h5 class="card-title">Upcoming Events</h5>
                    <h2 class="display-4">0</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-4">
        You haven't created any events yet. Click "Create New Event" to get started.
    </div>
</div>