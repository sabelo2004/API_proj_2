@model IEnumerable<RaceDay.Web.ViewModels.MyEnrolmentsViewModel>
@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-5">
    <h2>My Enrolments</h2>
    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have not enrolled in any events yet.
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Browse Events</a>
    }
    else
    {
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Event Name</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.EventName</td>
                        <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@item.CategoryName</td>
                        <td>
                            <span class="badge @(item.Status == "Confirmed" ? "bg-success" : "bg-warning text-dark")">
                                @item.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>